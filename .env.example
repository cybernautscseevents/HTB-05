# ACSA Environment Configuration
ACSA_ENV=development
ACSA_API_HOST=127.0.0.1
ACSA_API_PORT=8000
ACSA_LOG_LEVEL=INFO

# Security and Sandbox Constraints
ACSA_WORKSPACE_DIR=.acsa_workspaces
ACSA_SCAN_TIMEOUT_SECONDS=300
ACSA_MAX_SCAN_FILE_SIZE_BYTES=52428800
ACSA_ALLOW_ARBITRARY_CODE_EXECUTION=false
